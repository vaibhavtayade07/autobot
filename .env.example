# autobot — environment template (copy to .env and fill in real secrets)
# All secret keys are read with the AUTOBO_ prefix by pydantic-settings.
# NEVER commit the real .env.

# --- Binance (crypto) ---
AUTOBO_BINANCE_API_KEY=your_binance_api_key
AUTOBO_BINANCE_API_SECRET=your_binance_api_secret

# --- OpenAlgo / Angel One (Indian equities) ---
AUTOBO_OPENALGO_URL=http://127.0.0.1:5000
AUTOBO_ANGEL_API_KEY=your_angel_api_key
AUTOBO_ANGEL_CLIENT_ID=your_angel_client_id
AUTOBO_ANGEL_PASSWORD=your_angel_password
AUTOBO_ANGEL_TOTP_SECRET=your_angel_totp_base32_secret
AUTOBO_ANGEL_FEED_TOKEN=optional_feed_token

# --- Optional ---
# AUTOBO_CONFIG=D:/micro-saas/vstudio/GitHub/autobot/autobot/config/default.yaml
